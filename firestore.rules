rules_version = '2';

// ============================================================================
// FIRESTORE SECURITY RULES - BAGITIGAKAN (SMART SPLIT-BILL & BUDGET)
// Mengimplementasikan RBAC Lapis ke-2 (Deny-by-default, NFR-01, Tabel 2.5, BR-07)
// Kompatibel dengan Firebase Local Emulator Suite & Cloud Firestore produksi.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Cek apakah pengguna sudah login
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Cek apakah pengguna adalah pemilik dokumen
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Helper: Cek apakah pengguna adalah anggota grup (group_members)
    function isMember(gid) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid));
    }

    // Helper: Cek apakah pengguna memiliki role 'admin' tetap di grup
    function isGroupAdmin(gid) {
      return isMember(gid) &&
        get(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper: Cek apakah pengguna adalah Bill Creator kontekstual pada tagihan tertentu
    function isBillCreator(gid, bid) {
      return isMember(gid) &&
        get(/databases/$(database)/documents/groups/$(gid)/bills/$(bid)).data.creator_uid == request.auth.uid;
    }

    // 1. Entitas USERS & USER_DEVICES (D1)
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(uid);
      allow delete: if false;

      match /devices/{deviceId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Transaksi Kode Undangan Unik (BR-07)
    match /invite_codes/{code} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        !exists(/databases/$(database)/documents/invite_codes/$(code));
      // Hanya Admin Grup pemilik kode yang boleh menghapus kode undangan
      allow delete: if isAuthenticated() &&
        resource.data.group_id is string &&
        isGroupAdmin(resource.data.group_id);
    }

    // 2. Entitas GROUPS & GROUP_MEMBERS (D2)
    match /groups/{gid} {
      // Non-anggota ditolak membaca grup (FR-02, BR-07).
      // Pengecekan member_uids memungkinkan list query `.where('member_uids', arrayContains: uid)`.
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.member_uids || isMember(gid)
      );
      allow create: if isAuthenticated() &&
        request.resource.data.admin_uid == request.auth.uid &&
        request.auth.uid in request.resource.data.member_uids;
      // Group Admin bebas mengubah info grup; pengguna baru yang gabung via kode hanya
      // boleh MENAMBAHKAN dirinya sendiri ke member_uids tanpa menghapus anggota lain.
      allow update: if isGroupAdmin(gid) || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['member_uids']) &&
        request.resource.data.member_uids.hasAll(resource.data.member_uids) &&
        request.resource.data.member_uids.size() == resource.data.member_uids.size() + 1 &&
        request.auth.uid in request.resource.data.member_uids
      );
      allow delete: if isGroupAdmin(gid);

      match /members/{uid} {
        allow read: if isMember(gid);
        // Gabung mandiri sebagai 'member', pembuat grup sebagai 'admin', atau Admin menambah 'member'
        allow create: if isAuthenticated() && (
          (request.auth.uid == uid && request.resource.data.role == 'member') ||
          (request.auth.uid == uid && request.resource.data.role == 'admin' &&
            getAfter(/databases/$(database)/documents/groups/$(gid)).data.admin_uid == request.auth.uid) ||
          (isGroupAdmin(gid) && request.resource.data.role == 'member')
        );
        allow update, delete: if isGroupAdmin(gid);
      }

      // 3. Entitas BILLS, BILL_ITEMS, ITEM_ASSIGNMENTS, BILL_PARTICIPANTS (D3 & D4)
      match /bills/{bid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid) &&
          request.resource.data.creator_uid == request.auth.uid;
        // Bill Creator bebas mengedit/verifikasi tagihan.
        // Anggota biasa HANYA boleh memperbarui status pembayaran miliknya sendiri
        // pada `participant_summaries[uid]` dari unpaid/rejected -> pending/unpaid
        // tanpa boleh mengubah nominal (total_due_idr) atau field lain.
        allow update: if isBillCreator(gid, bid) || (
          isMember(gid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participant_summaries']) &&
          request.resource.data.participant_summaries
            .diff(resource.data.participant_summaries)
            .affectedKeys()
            .hasOnly([request.auth.uid]) &&
          request.resource.data.participant_summaries[request.auth.uid].total_due_idr ==
            resource.data.participant_summaries[request.auth.uid].total_due_idr &&
          resource.data.participant_summaries[request.auth.uid].payment_status in ['unpaid', 'rejected'] &&
          request.resource.data.participant_summaries[request.auth.uid].payment_status in ['pending', 'unpaid']
        );
        // Hapus tagihan hanya oleh Creator atau Group Admin
        allow delete: if isBillCreator(gid, bid) || isGroupAdmin(gid);

        match /items/{itemId} {
          allow read: if isMember(gid);
          allow write: if isBillCreator(gid, bid) || isGroupAdmin(gid);

          match /assignments/{debtorUid} {
            allow read: if isMember(gid);
            allow write: if isBillCreator(gid, bid) || isGroupAdmin(gid);
          }
        }

        // Siklus status pembayaran ketat (BR-04 & FR-05)
        match /participants/{debtorUid} {
          allow read: if isMember(gid);
          allow create, delete: if isBillCreator(gid, bid) || isGroupAdmin(gid);
          allow update: if (
            // Member (Debitur) hanya boleh mengubah miliknya sendiri: unpaid/rejected -> pending atau rejected -> unpaid
            (isOwner(debtorUid) &&
              request.resource.data.total_due_idr == resource.data.total_due_idr &&
              resource.data.payment_status in ['unpaid', 'rejected'] &&
              request.resource.data.payment_status in ['pending', 'unpaid'])
            ||
            // Hanya Bill Creator yang boleh memverifikasi (paid), menolak (rejected), atau memperbarui saat edit tagihan
            isBillCreator(gid, bid)
          );
        }
      }
    }

    // 4. Entitas NOTIFICATIONS (D5)
    match /notifications/{notifId} {
      allow read, update: if isAuthenticated() &&
        resource.data.receiver_uid == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.sender_uid == request.auth.uid;
      allow delete: if false;
    }
  }
}
